diff --git a/source/verl/trainer/core_algos.py b/source/verl/trainer/core_algos.py
index c13a677..f0fa8bd 100644
--- a/source/verl/trainer/core_algos.py
+++ b/source/verl/trainer/core_algos.py
@@ -829,3 +829,18 @@ def compute_ptd_mask(
                     ptd_mask[idx] = True
 
     return ptd_mask, ptd_group_mask
+
+
+def compute_kl_keep_mask(accuracy_scores: torch.Tensor, kl_mask_mode: str) -> torch.Tensor:
+    """KL ablation: [B] bool, True = trajectory keeps the reference KL loss.
+
+    'all' keeps every trajectory, 'none' drops every trajectory, 'correct' keeps only
+    trajectories with accuracy == 1.0 (the same correctness rule as compute_ptd_mask).
+    """
+    if kl_mask_mode == "all":
+        return torch.ones(accuracy_scores.shape[0], dtype=torch.bool)
+    if kl_mask_mode == "none":
+        return torch.zeros(accuracy_scores.shape[0], dtype=torch.bool)
+    if kl_mask_mode == "correct":
+        return accuracy_scores == 1.0
+    raise ValueError(f"compute_kl_keep_mask does not handle kl_mask_mode={kl_mask_mode!r}")
